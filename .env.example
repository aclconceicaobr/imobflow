# Copie para .env.local e preencha. Nunca coloque valores reais neste arquivo.
# Detalhes de cada variável em docs/operacao.md.
# Regra: só as variáveis abaixo com NEXT_PUBLIC_ vão para o navegador.
# O build falha se um segredo ganhar esse prefixo.

# --- Públicas (vão para o navegador) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Secretas (só no servidor) ---
SUPABASE_SECRET_KEY=
TURNSTILE_SECRET_KEY=

# --- Onda 2: cobrança (Asaas). Com BILLING_ENABLED=true as chaves são obrigatórias ---
BILLING_ENABLED=false
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# --- Onda 2: IA (OpenAI). Com AI_ENABLED=true chave e modelo são obrigatórios ---
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
